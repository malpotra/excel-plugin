<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS: runs the server at login and restarts it if it dies.
     1. Replace YOUR_USER and the two paths below (run `which node` for the node path).
     2. cp this file to ~/Library/LaunchAgents/com.tablesaver.plist
     3. launchctl load ~/Library/LaunchAgents/com.tablesaver.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tablesaver</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/YOUR_USER/table-saver-addin/server.js</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/YOUR_USER/table-saver-addin</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/tablesaver.log</string>
  <key>StandardErrorPath</key><string>/tmp/tablesaver.err.log</string>
</dict>
</plist>
